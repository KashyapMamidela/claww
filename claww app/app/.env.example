# Copy this file to .env and fill in your actual Supabase values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the client — the
# anon key is meant to be public (protected by RLS), never the service role key.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# SHIP PHASE 9.1 — optional. Leave blank to disable crash reporting entirely
# (see lib/sentry.ts). Get this from sentry.io -> Project Settings -> Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# SHIP PHASE 9.2 — optional. Leave blank to disable analytics entirely
# (see lib/analytics.ts). Get these from posthog.com -> Project Settings.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
